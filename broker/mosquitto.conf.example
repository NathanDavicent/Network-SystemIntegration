# Mosquitto example config (no secrets).
# 1. Create certificates in C:\iot\certs (see README) and the password file:
#      mosquitto_passwd -c C:\iot\passwd esp32
#      mosquitto_passwd -b C:\iot\passwd service "<password>"
# 2. Copy this file to C:\iot\mosquitto.conf

allow_anonymous false
password_file C:/iot/passwd

# Local listener for the Python service (not reachable from the network)
listener 1883 localhost

# TLS listener for the ESP32
listener 8883
cafile C:/iot/certs/ca.crt
certfile C:/iot/certs/server.crt
keyfile C:/iot/certs/server.key